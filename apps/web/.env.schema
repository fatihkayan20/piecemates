# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# Sentry project for this app; empty turns Sentry off.
# @public @optional @type=url
VITE_SENTRY_DSN=

# PostHog project key; empty turns analytics off.
# @public @optional
VITE_POSTHOG_KEY=

# @public @optional @type=url
VITE_POSTHOG_HOST=

# Uploads source maps to Sentry when building.
# @optional
SENTRY_AUTH_TOKEN=

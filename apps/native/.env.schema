# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
EXPO_PUBLIC_SERVER_URL=

# The web app's origin, for share links.
# @public @type=url
EXPO_PUBLIC_WEB_URL=

# Sentry project for this app; empty turns Sentry off.
# @public @optional @type=url
EXPO_PUBLIC_SENTRY_DSN=

# PostHog project key; empty turns analytics off.
# @public @optional
EXPO_PUBLIC_POSTHOG_KEY=

# @public @optional @type=url
EXPO_PUBLIC_POSTHOG_HOST=

# Uploads source maps to Sentry when building.
# @optional
SENTRY_AUTH_TOKEN=

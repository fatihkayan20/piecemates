    "drizzle-orm": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@piecemates/config": "workspace:*",
    "@piecemates/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}

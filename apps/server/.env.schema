# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Sentry project for the server; empty turns Sentry off.
# @optional @type=url
SENTRY_DSN=

# R2 API token (Object Read & Write) for presigned photo upload URLs.
# @type=string
R2_ACCESS_KEY_ID=
# @type=string
R2_SECRET_ACCESS_KEY=

# Unsplash app Access Key, for the sample photo catalogue.
# @type=string
UNSPLASH_ACCESS_KEY=
